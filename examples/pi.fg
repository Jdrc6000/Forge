fn isqrt(n) {
    if n < 2 { return n }
    d = len(str(n))
    x = 10 ^ (d // 2 + 1)
    y = (x + n // x) // 2
    while y < x {
        x = y
        y = (x + n // x) // 2
    }
    return x
}

fn chudnovsky(digits) {
    one = 10 ^ (2 * digits + 40)

    k = 1
    a_k = one
    a_sum = one
    b_sum = 0
    C = 640320
    C3_OVER_24 = C ^ 3 // 24
    while true {
        a_k = a_k * (-(6 * k - 5) * (2 * k - 1) * (6 * k - 1))
        a_k = a_k // (k * k * k * C3_OVER_24)
        a_sum = a_sum + a_k
        b_sum = b_sum + (k * a_k)
        k = k + 1
        if a_k == 0 { break }
    }
    total = 13591409 * a_sum + 545140134 * b_sum
    pi = (426880 * isqrt(10005 * one) * one) // total
    return pi // (10 ^ 20)
}

println(str(chudnovsky(100000)))